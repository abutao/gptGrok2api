# GPTGrok2API Go runtime configuration

# Required API credentials
CHATGPT2API_AUTH_KEY=replace-with-api-key
CHATGPT2API_ADMIN_KEY=replace-with-admin-key

# Host port; production default is 3000
CHATGPT2API_GO_PORT=3000

# Public URL used for locally stored image links
# GO_PUBLIC_BASE_URL=http://your-server:3000

# Runtime settings
GO_VERSION=1.2.1-go
GO_REQUEST_TIMEOUT_SECONDS=180
GO_CHAT_MAX_RETRIES=2
GO_IMAGE_ACCOUNT_CONCURRENCY=1
GO_IMAGE_MAX_CONCURRENCY=128
GO_QUEUE_BACKEND=redis
GO_REDIS_ADDR=redis:6379

# Optional upstream/proxy settings
# GO_UPSTREAM_URL=
# GO_UPSTREAM_API_KEY=
# GO_OPENAI_BASE_URL=https://chatgpt.com
# GO_PROXY_URL=
# GO_PROXY_POOL=http://user:pass@host:port,socks5://host:port
# GO_RESOURCE_PROXY_URL=
# GO_RESOURCE_PROXY_POOL=
# GO_PROXY_UPSTREAMS_FILE=upstreams.txt

# Optional image/media retention
# GO_IMAGE_RETENTION_DAYS=1
# GO_IMAGE_CLEANUP_INTERVAL_SECONDS=3600

# Optional registration integrations
# GO_REGISTER_MAIL_URL=
# GO_REGISTER_CAPTCHA_URL=
# GO_REGISTER_DRIVER_URL=
# GO_REGISTER_DRIVER_KEY=

# Time zone
TZ=Asia/Shanghai
